# Tài khoản admin mặc định (chạy: npm run seed:admin để tạo)
ADMIN_EMAIL=admin@nutrilens.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FULLNAME=Super Admin
PORT=5000

# AI Service (FastAPI) — chạy: uvicorn main:app --host 127.0.0.1 --port 8000 trong thư mục ai_service/
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=15000

JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
